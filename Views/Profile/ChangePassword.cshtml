@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="account-page section-ptb">

    <div class="container">

        <div class="row row-mtm align-items-lg-start">

            <div class="col-12 col-lg-4 col-xl-3">

                <div class="ap-info">

                    <div class="ap-author ptb-30 plr-15 extra-bg text-center border-radius">

                        <img src="~/images/profile/default-profile.png"
                             class="width-72 img-fluid rounded-circle"
                             alt="Profile picture">

                        <div class="ap-ac mst-26">

                            <h6 class="font-18">
                                Delton Novela
                            </h6>

                            <span class="d-inline-block mst-7">
                                @@DeltonNovela
                            </span>

                        </div>

                    </div>


                    <div class="ap-profile">

                        <a asp-action="MyProfile"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">
                            <i class="ri-user-settings-line icon-16 mer-5"></i>
                            <span>My Profile</span>
                        </a>

                        <a asp-action="MyPurchase"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">
                            <i class="ri-shopping-bag-3-line icon-16 mer-5"></i>
                            <span>My Purchases</span>
                        </a>

                        <a asp-action="MyListing"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">
                            <i class="ri-price-tag-3-line icon-16 mer-5"></i>
                            <span>My Listings</span>
                        </a>

                        <a asp-action="Notifications"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">
                            <i class="ri-notification-line icon-16 mer-5"></i>
                            <span>Notifications</span>
                        </a>

                        <a asp-action="VerifyAccount"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">
                            <i class="ri-shield-check-line icon-16 mer-5"></i>
                            <span>Verify Account</span>
                        </a>

                        <a asp-action="ChangePassword"
                           class="primary-color d-flex align-items-center ptb-15 plr-15">
                            <i class="ri-lock-password-line icon-16 mer-5"></i>
                            <span>Change Password</span>
                        </a>

                        <a asp-action="DeleteAccount"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">
                            <i class="ri-delete-bin-line icon-16 mer-5"></i>
                            <span>Delete Account</span>
                        </a>

                        <a asp-action="Logout"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">
                            <i class="ri-logout-box-line icon-16 mer-5"></i>
                            <span>Logout</span>
                        </a>

                    </div>

                </div>

            </div>


            <div class="col-12 col-lg-8 col-xl-9">

                <div class="ap-detail">

                    <form asp-action="ChangePassword"
                          method="post">

                        <div class="acc-info">

                            <div class="acc-title">

                                <h6 class="font-18">
                                    Password
                                </h6>

                            </div>


                            <div class="acc-detail mst-22">

                                <div class="acc-detail-field">

                                    <div class="row field-row">


                                        <div class="col-12 field-col">

                                            <label class="field-label"
                                                   for="CurrentPassword">

                                                Current password

                                            </label>

                                            <div class="field-pwd">

                                                <input type="password"
                                                       id="CurrentPassword"
                                                       name="CurrentPassword"
                                                       class="w-100"
                                                       required>

                                                <button type="button"
                                                        class="field-pwd-eye">

                                                    <i class="ri-eye-line"></i>

                                                </button>

                                            </div>

                                        </div>


                                        <div class="col-12 field-col">

                                            <label class="field-label"
                                                   for="NewPassword">

                                                New password

                                            </label>

                                            <div class="field-pwd">

                                                <input type="password"
                                                       id="NewPassword"
                                                       name="NewPassword"
                                                       class="w-100"
                                                       required>

                                                <button type="button"
                                                        class="field-pwd-eye">

                                                    <i class="ri-eye-line"></i>

                                                </button>

                                            </div>

                                        </div>


                                        <div class="col-12 field-col">

                                            <label class="field-label"
                                                   for="ConfirmPassword">

                                                Confirm password

                                            </label>

                                            <div class="field-pwd">

                                                <input type="password"
                                                       id="ConfirmPassword"
                                                       name="ConfirmPassword"
                                                       class="w-100"
                                                       required>

                                                <button type="button"
                                                        class="field-pwd-eye">

                                                    <i class="ri-eye-line"></i>

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <div class="ap-profile-button mst-20 mst-sm-30">

                                    <div class="row btn-row">

                                        <div class="col-12 col-sm-6 col-xl-3">

                                            <button type="submit"
                                                    class="w-100 acc-save btn-style quaternary-btn">

                                                Save & Close

                                            </button>

                                        </div>


                                        <div class="col-12 col-sm-6 col-xl-3">

                                            <a asp-action="MyProfile"
                                               class="w-100 acc-cancel btn-style secondary-btn">

                                                Cancel

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>