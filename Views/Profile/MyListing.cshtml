@{
    ViewData["Title"] = "My Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="account-page section-ptb">

    <div class="container">

        <div class="row row-mtm align-items-lg-start">

            <!-- SIDEBAR -->

            <div class="col-12 col-lg-4 col-xl-3">

                <div class="ap-info">

                    <div class="ap-author ptb-30 plr-15 extra-bg text-center border-radius">

                        <img src="~/images/profile/default-profile.png"
                             class="width-72 img-fluid rounded-circle"
                             alt="Profile picture">

                        <div class="ap-ac mst-26">

                            <h6 class="font-18">
                                Delton Novela
                            </h6>

                            <span class="d-inline-block mst-7">
                                @@DeltonNovela
                            </span>

                        </div>

                    </div>


                    <div class="ap-profile">

                        <a asp-action="MyProfile"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">

                            <i class="ri-user-settings-line icon-16 mer-5"></i>

                            <span class="ap-name">
                                My Profile
                            </span>

                        </a>


                        <a asp-action="MyPurchase"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">

                            <i class="ri-shopping-bag-3-line icon-16 mer-5"></i>

                            <span class="ap-name">
                                My Purchases
                            </span>

                        </a>


                        <a asp-action="MyListing"
                           class="primary-color d-flex align-items-center ptb-15 plr-15">

                            <i class="ri-price-tag-3-line icon-16 mer-5"></i>

                            <span class="ap-name">
                                My Listings
                            </span>

                        </a>


                        <a asp-action="Notifications"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">

                            <i class="ri-notification-line icon-16 mer-5"></i>

                            <span class="ap-name me-auto">
                                Notifications
                            </span>

                            <span class="ap-count extra-color font-12 d-flex align-items-center justify-content-center secondary-bg rounded-circle">
                                3
                            </span>

                        </a>


                        <a asp-action="VerifyAccount"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">

                            <i class="ri-shield-check-line icon-16 mer-5"></i>

                            <span class="ap-name">
                                Verify Account
                            </span>

                        </a>


                        <a asp-action="ChangePassword"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">

                            <i class="ri-lock-password-line icon-16 mer-5"></i>

                            <span class="ap-name">
                                Change Password
                            </span>

                        </a>


                        <a asp-action="DeleteAccount"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">

                            <i class="ri-delete-bin-line icon-16 mer-5"></i>

                            <span class="ap-name">
                                Delete Account
                            </span>

                        </a>


                        <a asp-action="Logout"
                           class="body-primary-color d-flex align-items-center ptb-15 plr-15">

                            <i class="ri-logout-box-line icon-16 mer-5"></i>

                            <span class="ap-name">
                                Logout
                            </span>

                        </a>

                    </div>

                </div>

            </div>


            <!-- CONTENT -->

            <div class="col-12 col-lg-8 col-xl-9">

                <div class="ap-detail">

                    <div class="acc-info">

                        <div class="acc-title d-flex justify-content-between align-items-center">

                            <h6 class="font-18">
                                My Listings
                            </h6>

                            <a href="#"
                               class="btn-style secondary-btn">

                                Add Listing

                            </a>

                        </div>


                        <div class="acc-detail mst-22">

                            <!-- LISTING 1 -->

                            <div class="listing-item ptb-20 border-top">

                                <div class="row align-items-center">

                                    <div class="col-12 col-md-3">

                                        <img src="~/images/products/product-placeholder.png"
                                             class="img-fluid border-radius"
                                             alt="Java textbook">

                                    </div>

                                    <div class="col-12 col-md-6 mt-15 mt-md-0">

                                        <h6 class="font-16">
                                            Java Programming Textbook
                                        </h6>

                                        <span class="d-block mst-7">
                                            R250
                                        </span>

                                        <span class="d-block mst-5">
                                            Active listing
                                        </span>

                                    </div>

                                    <div class="col-12 col-md-3 mt-15 mt-md-0">

                                        <a href="#"
                                           class="d-block primary-link">

                                            Edit

                                        </a>

                                        <a href="#"
                                           class="d-block primary-link mst-10">

                                            Remove

                                        </a>

                                    </div>

                                </div>

                            </div>


                            <!-- LISTING 2 -->

                            <div class="listing-item ptb-20 border-top">

                                <div class="row align-items-center">

                                    <div class="col-12 col-md-3">

                                        <img src="~/images/products/product-placeholder.png"
                                             class="img-fluid border-radius"
                                             alt="Calculator">

                                    </div>

                                    <div class="col-12 col-md-6 mt-15 mt-md-0">

                                        <h6 class="font-16">
                                            Scientific Calculator
                                        </h6>

                                        <span class="d-block mst-7">
                                            R400
                                        </span>

                                        <span class="d-block mst-5">
                                            Active listing
                                        </span>

                                    </div>

                                    <div class="col-12 col-md-3 mt-15 mt-md-0">

                                        <a href="#"
                                           class="d-block primary-link">

                                            Edit

                                        </a>

                                        <a href="#"
                                           class="d-block primary-link mst-10">

                                            Remove

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>