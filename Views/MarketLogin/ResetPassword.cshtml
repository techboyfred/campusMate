@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>



    <form class="card" asp-controller="MarketLogin" asp-action="ResetPassword" method="post">
        <!--Error messages-->
        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="error-message">
                @ViewData["ErrorMessage"]
            </div>
        }

        <img src="~/images/campusMateLogo.png" alt="CampusMate Logo" class="logo" />

        <h2 class="uj-title">University of Johannesburg</h2>

        <p class="campusmate-title">
            campus<span>Mate</span>
        </p>

        <h1>Reset Password</h1>
        <p class="sub">Choose a new password for your account.</p>

        <!-- Carries the token through from the GET request - the actual security
             check happens server-side again on submit, this just avoids making
             the user paste the link a second time -->
        <input type="hidden" name="token" value="@ViewData["Token"]" />

        <div class="field">
            <input type="password"
                   id="newPassword-textfield"
                   name="newPassword"
                   placeholder="New Password"
                   autocomplete="new-password"
                   required />
            <label for="newPassword-textfield">New Password</label>

            <button type="button"
                    class="peek"
                    aria-label="Show password"
                    onclick="const p=document.getElementById('newPassword-textfield'); p.type=p.type==='password'?'text':'password'; this.textContent=p.type==='password'?'SHOW':'HIDE';">
                SHOW
            </button>
        </div>

        <div class="field">
            <input type="password"
                   id="confirmNewPassword-textfield"
                   name="confirmNewPassword"
                   placeholder="Confirm New Password"
                   autocomplete="new-password"
                   required />
            <label for="confirmNewPassword-textfield">Confirm New Password</label>

            <button type="button"
                    class="peek"
                    aria-label="Show password"
                    onclick="const p=document.getElementById('confirmNewPassword-textfield'); p.type=p.type==='password'?'text':'password'; this.textContent=p.type==='password'?'SHOW':'HIDE';">
                SHOW
            </button>
        </div>

        <button class="go" type="submit">
            Reset Password
        </button>

        <div class="meta">
            <span>
                Remembered it after all?
                <a asp-controller="MarketLogin" asp-action="MarketLogin">
                    Sign in
                </a>
            </span>
        </div>
    </form>
</body>
</html>
