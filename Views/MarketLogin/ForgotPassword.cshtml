<!--NO footer or header-->
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body>
  

    <form class="card" method="post">
        <!--ERROR MESSAGE(S)-->
        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="error-message">
                @ViewData["ErrorMessage"]
            </div>
        }

        @if (ViewData["InfoMessage"] != null)
        {
            <div class="info-message">
                @ViewData["InfoMessage"]
            </div>
        }

        <img src="~/images/campusMateLogo.png"
             class="logo"
             alt="CampusMate Logo" />

        <h2 class="uj-title">University of Johannesburg</h2>

        <p class="campusmate-title">
            campus<span>Mate</span>
        </p>

        <h1>Forgot password</h1>

        <p class="sub">
            Enter your student email and we'll send a reset link.
        </p>

        <div class="field">

            <input type="text"
                   id="studentEmail-textfield"
                   name="studentEmail"
                   placeholder="Email"
                   autocomplete="email"
                   required />

            <label for="studentEmail">Student Email</label>

        </div>

        <button class="go" type="submit">
            Send reset link
        </button>

        <div class="meta">
            <a asp-controller="MarketLogin"
               asp-action="MarketLogin">
                Back to sign in
            </a>
        </div>

    </form>

</body>
</html>