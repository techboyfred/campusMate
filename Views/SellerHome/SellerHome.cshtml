@model UJConnect.Models.SellerHomeViewModel
@{
    Layout = null;
    bool canAddProduct = Model.IsVerified && Model.HasAvailability;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Home — CampusMate</title>
    <link rel="stylesheet" href="~/css/marketplace.css" asp-append-version="true" />
</head>
<body>

    <div class="topbar">
        <div class="wordmark">campus<span>Mate</span></div>
        <details class="account-menu">
            <summary>@Model.Username &#9662;</summary>
            <div class="account-dropdown">
                <a asp-controller="Profile" asp-action="Profile">Profile</a>
                <a asp-controller="MarketHome" asp-action="MarketHome">Buyer View</a>
                <a asp-controller="MarketLogin" asp-action="Logout">Logout</a>
            </div>
        </details>
    </div>

    <div class="page-body">
        <h1 class="page-title">Seller Home</h1>

        <!-- Setup stepper: this is a real sequence - verification and availability
             both gate whether "Add New" is usable, so the connected-dot layout
             reflects an actual dependency, not just decoration -->
        <div class="setup-stepper">
            <div class="step @(Model.IsVerified ? "done" : "")">
                <div class="step-dot">@(Model.IsVerified ? "✓" : "1")</div>
                <div class="step-label">Account verified</div>
            </div>
            <div class="step-connector @(Model.IsVerified ? "done" : "")"></div>
            <div class="step @(Model.HasAvailability ? "done" : "")">
                <div class="step-dot">@(Model.HasAvailability ? "✓" : "2")</div>
                <div class="step-label">Availability added</div>
            </div>
        </div>

        <div class="count-row">
            <span class="count-label"><strong>@Model.Products.Count</strong> product(s) added</span>
            <button class="btn btn-primary" id="addNewBtn" @(canAddProduct ? "" : "disabled") title="@(canAddProduct ? "" : "Verify your account and add availability first")">
                + Add New
            </button>
        </div>

        <!-- Default state (per your sketch): neither section shown until the seller picks one -->
        <div class="section-toggle">
            <button class="btn btn-outline" id="showProductsBtn" onclick="showSection('products')">Show Products</button>
            <button class="btn btn-outline" id="showAvailabilityBtn" onclick="showSection('availability')">Show Availability</button>
        </div>

        <div id="productsSection" style="display:none;">
            <div class="search-bar">
                <input type="text" id="productSearch" placeholder="Search your products..." />
                <button class="clear-btn" type="button" onclick="document.getElementById('productSearch').value=''">&times;</button>
            </div>

            @if (Model.Products.Count > 0)
            {
                <div class="product-grid">
                    @foreach (var product in Model.Products)
                    {
                        <div class="product-card">
                            <div class="product-photo">
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="@product.ProductName" />
                                }
                                else
                                {
                                    <span>No photo</span>
                                }
                            </div>
                            <div class="product-info">
                                <div class="product-name">@product.ProductName</div>
                                <div class="product-price">R@product.LowestPackagePrice</div>
                                <div class="product-actions">
                                    <button class="icon-btn" title="@product.ProductDescription">&#9432;</button>
                                    <a class="btn btn-outline" asp-controller="Product" asp-action="Edit" asp-route-productId="@product.ProductID">Edit</a>
                                    <a class="btn btn-danger-outline" asp-controller="Product" asp-action="Remove" asp-route-productId="@product.ProductID">Remove</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">You have not added any products yet.</div>
            }
        </div>

        <div id="availabilitySection" style="display:none;">
            <form class="availability-form" asp-controller="Seller" asp-action="AddAvailability" method="post">
                <div>
                    <label for="dayOfWeek">Day</label>
                    <select id="dayOfWeek" name="dayOfWeek" required>
                        <option value="MONDAY">Monday</option>
                        <option value="TUESDAY">Tuesday</option>
                        <option value="WEDNESDAY">Wednesday</option>
                        <option value="THURSDAY">Thursday</option>
                        <option value="FRIDAY">Friday</option>
                        <option value="SATURDAY">Saturday</option>
                        <option value="SUNDAY">Sunday</option>
                    </select>
                </div>
                <div>
                    <label for="venue">Venue</label>
                    <select id="venue" name="locationId" required>
                        @foreach (var venue in Model.Venues)
                        {
                            <option value="@venue.LocationID">@venue.LocationName</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="startTime">Start time</label>
                    <input type="time" id="startTime" name="startTime" required />
                </div>
                <div>
                    <label for="endTime">End time</label>
                    <input type="time" id="endTime" name="endTime" required />
                </div>
                <div class="full-row">
                    <button class="btn btn-primary" type="submit">+ Add Availability</button>
                </div>
            </form>
        </div>

        <div class="back-row">
            <a class="btn btn-outline" asp-controller="Home" asp-action="Index">Back</a>
        </div>
    </div>

    <script>
        function showSection(section) {
            const products = document.getElementById('productsSection');
            const availability = document.getElementById('availabilitySection');
            const productsBtn = document.getElementById('showProductsBtn');
            const availabilityBtn = document.getElementById('showAvailabilityBtn');

            const showProducts = section === 'products';
            products.style.display = showProducts ? 'block' : 'none';
            availability.style.display = showProducts ? 'none' : 'block';
            productsBtn.classList.toggle('active', showProducts);
            availabilityBtn.classList.toggle('active', !showProducts);
        }
    </script>

</body>
</html>
